#!/bin/bash
#SBATCH --job-name=regridg
#SBATCH --partition=gpuq
#SBATCH --qos=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:A100.80gb:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64GB
# 3 days, not 1. The 24h cap killed ioi/qwen3-4b seeds 22 and 33 outright (seed 11 survived at
# 20:30, so the cap was cutting into the middle of the distribution, not clipping an outlier).
# qwen3-4b is 43,993 edges and every remaining chunk is a 4B cell; the partition allows 5 days,
# so a generous cap costs nothing and a tight one silently deletes cells from the grid.
#SBATCH --time=3-00:00:00
#SBATCH --output=outputs/regridg_%A_%a.out
#SBATCH --array=0-95%8
#
# Re-run of the C1 grid with the selection fix (2026-08-06).
#
# What changed, and only this, so the effect is attributable:
#   1. controller validation split 200 -> 2000 examples (data/<task>/<model>/eval_big.jsonl,
#      generated by scripts/prepare_bigval.py, disjoint from train and the sealed test)
#   2. accept rule uses a one-sided 95% lower confidence bound instead of a point estimate
#      (--accept-lcb 1.645), so an accepted circuit is conservative by construction
#   3. edge floor 4 -> 1, so the Gemma endpoints are the model's and not the controller's
#   4. the last 6 accepted states are saved, so the trajectory can be re-scored offline
#
# Deliberately NOT changed: the faithfulness metric, the capability probe corpus, the
# ranking, the cut schedule, the seeds. Bundling those would make "how much of the 12.2x
# survives the selection fix" unanswerable, which is the question the review asked.
#
# Writes results/headgrid/c1gate/seed<S>/<task>_<model>_knee.json

set -euo pipefail
cd ${ILM_ROOT:-$PWD}

TASKS=(ioi agreement induction doc)
MODELS=(gpt2 llama llama3b gemma1b gemma4b qwen3-0.6b qwen3-1.7b qwen3-4b)
SEEDS=(11 22 33)
declare -A PREFIX=( [ioi]=ioi [agreement]=agr [induction]=ind [doc]=doc )
declare -A TDIR=( [ioi]=ioi [agreement]=agreement [induction]=induction [doc]=docstring )

I=$SLURM_ARRAY_TASK_ID
SEED=${SEEDS[$(( I % 3 ))]}
REST=$(( I / 3 ))
MODEL=${MODELS[$(( REST % 8 ))]}
TASK=${TASKS[$(( REST / 8 ))]}

CKPT="checkpoints/${PREFIX[$TASK]}_${MODEL}_head_fresh"
OUT="results/headgrid/c1gate/seed${SEED}/${TASK}_${MODEL}_knee.json"
SAVE="checkpoints/c1gate/seed${SEED}/${PREFIX[$TASK]}_${MODEL}"
mkdir -p "$(dirname "$OUT")" "$SAVE"

# Skip a cell that already has a knee file. Re-submitting a range to recover a few dead cells
# is the normal repair, and without this it silently re-runs every finished cell in that range
# and overwrites results that downstream analyses have already been built on. Pass FORCE=1 to
# deliberately recompute.
if [ -s "$OUT" ] && [ "${FORCE:-0}" != "1" ]; then
  echo "=== regrid task $I: $TASK/$MODEL seed $SEED -- $OUT exists, skipping (FORCE=1 to redo) ==="
  exit 0
fi

echo "=== regrid task $I: $TASK/$MODEL seed $SEED -> $OUT ==="
export CKPT TASK MODEL_NAME="$MODEL" SEED
export ADAPTIVE=1 CAP_GATE=1.05 MEASURE_PANEL=1
export ADAPTIVE_MIN=1 ACCEPT_LCB=1.645
export EVAL_DATA="data/${TDIR[$TASK]}/${MODEL}/eval_big.jsonl" EVAL_BATCHES=250
export SAVE_ROUNDS="$SAVE" SAVE_ROUNDS_KEEP=6
export OUT

bash slurm/prune_heal_gradual.slurm
